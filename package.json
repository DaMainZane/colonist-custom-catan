{
  "name": "hexsettlers-online",
  "version": "1.0.0",
  "description": "Customizable Online Multiplayer Catan Board Game with Gold Tiles",
  "main": "dist/main.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "headers": "node scripts/headers.mjs",
    "headers:write": "node scripts/headers.mjs --write",
    "headers:check": "node scripts/headers.mjs --check",
    "index": "node scripts/index.mjs",
    "index:check": "node scripts/index.mjs --check"
  },
  "dependencies": {
    "express": "^4.19.2",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
